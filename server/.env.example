# ============================================================
#  Configuración del backend (copiar como server/.env)
# ============================================================

# Conexión a PostgreSQL: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tienda_zapatillas?schema=public"

# Puerto de la API
PORT=4000

# Secretos para firmar las sesiones (cámbialos por textos largos y aleatorios)
# Puedes generar uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_STORE="cambia-esto-por-un-secreto-largo-para-clientes"
JWT_SECRET_ADMIN="cambia-esto-por-OTRO-secreto-largo-para-administradores"

# Administrador inicial (se crea con "npm run db:seed")
ADMIN_EMAIL="admin@tienda.local"
ADMIN_PASSWORD="CambiaEstaClave123!"
ADMIN_NAME="Administrador"

# Orígenes permitidos para CORS (solo necesario si la tienda o el panel
# se sirven desde otro dominio que la API). Separados por comas.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Envío (en céntimos de sol): S/ 10.00 de tarifa plana, gratis desde S/ 300.00
SHIPPING_FLAT_CENTS=1000
FREE_SHIPPING_MIN_CENTS=30000

# En producción: "production" (activa cookies Secure y sirve las apps compiladas)
NODE_ENV=development
